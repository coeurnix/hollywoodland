{
  "name": "hollywoodland",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "observability": { "enabled": true },
  "r2_buckets": [ { "binding": "BUCKET", "bucket_name": "hollywoodland-stage" } ],
  // DEPLOY = R2 key prefix of the live build (switch/rollback = change this and redeploy; deploy-stage.mjs does it)
  "vars": { "DEPLOY": "v6" }
}
