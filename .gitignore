# item pipeline (tools/itemgen): 1024px originals stay local
item-art/icons-1024/
tools/itemgen/state/sample_request.txt
*.tmp
*.part
__pycache__/
art-gen/originals/

# Engine template Mannequin (retarget source only; Scripts/retarget_anims.py copies it from the engine)
hollywoodland-ue/Content/Characters/Mannequins/
# retarget rigs reference the Mannequins; Scripts/retarget_anims.py rebuilds them
hollywoodland-ue/Content/Characters/Rigs/

# sfx masters (tools/gen-sfx.mjs): the 16-bit WAVs from fal stay local; sfx/*.mp3 ship
sfx-src/

# dialoguegen raw TTS originals
vo-src/

# foliage (tools/foliagegen.py): Rodin originals (~370 MB) and FLUX references stay local; sprites, cards and assets.json ship
art/foliage/raw/
art/foliage/src/
art/foliage/state.json
# building kit (art/buildings): commit the game-ready kit and its sources; keep the bulk local
# (see art/buildings/HANDOVER.md: concept sheets, raw Rodin GLBs, work dirs and the big kit .blend files)
art/buildings/work/
art/buildings/concept/
art/buildings/src/rodin/
art/buildings/src/*.blend
*.blend1
art/buildings/meshes/*.glb
art/buildings/preview/*
!art/buildings/preview/*_contact.png
!art/buildings/preview/KitProof_*.png

# characters v2 (tools/charv2): the masters, exports and reviews stay local (multi-GB); the imported
# Content/CharactersV2 assets (1.3 GB, no LFS) are rebuilt with Scripts/ImportCharacters.ps1 -Script import_characters_v2.py
art/characters/
art/characters_v2/concepts/
art/characters_v2/export/
art/characters_v2/gear/
art/characters_v2/hats/
art/characters_v2/looks/
art/characters_v2/review/
art/characters_v2/src/
hollywoodland-ue/Content/CharactersV2/
# map painting logs
art/maps/logs/
# review notes and suggestion packages from playtests (local working material)
ART-NOTES.md
SUGGESTED-IMPROVEMENTS.md
suggestioned-improvements/
suggested-improvements-v2/

# the rendered trailer (tools/capture/trailer_cut.py rebuilds it)
tools/capture/trailer/
